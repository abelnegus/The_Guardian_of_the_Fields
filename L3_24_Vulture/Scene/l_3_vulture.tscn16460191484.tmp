[sub_resource type="GDScript" id="GDScript_07017"]
script/source = "extends CharacterBody2D

enum State {
	SOARING,
	SWOOPING,
	RETURNING
}

@export var soar_speed: float = 0.2
@export var swoop_speed: float = 250.0
@export var detection_radius: float = 200.0

var state = State.SOARING
var target_position: Vector2
var has_target := false

@onready var path_follow = $Path2D/PathFollow2D
@onready var screech = $Screech

var caravan_ref: Node2D

func _ready():
	caravan_ref = get_tree().get_root().get_node(\"Main/Caravan\")
	$AttackCheckTimer.start()

func _process(delta):
	match state:
		State.SOARING:
			soar(delta)
		State.SWOOPING:
			swoop(delta)
		State.RETURNING:
			return_to_path(delta)

# ---------------------------
# 🌀 SOARING (\"snore\")
# ---------------------------
func soar(delta):
	path_follow.progress_ratio += soar_speed * delta
	global_position = path_follow.global_position

# ---------------------------
# ⚡ SWOOPING
# ---------------------------
func swoop(delta):
	if not has_target:
		return

	var direction = (target_position - global_position).normalized()
	velocity = direction * swoop_speed
	move_and_slide()

	# Reached target
	if global_position.distance_to(target_position) < 10:
		state = State.RETURNING
		has_target = false

# ---------------------------
# 🔁 RETURN TO PATH
# ---------------------------
func return_to_path(delta):
	var direction = (path_follow.global_position - global_position).normalized()
	velocity = direction * swoop_speed
	move_and_slide()

	if global_position.distance_to(path_follow.global_position) < 10:
		state = State.SOARING

# ---------------------------
# 🎯 DETECTION LOGIC
# ---------------------------
func _on_AttackCheckTimer_timeout():
	if state != State.SOARING:
		return

	var dist = global_position.distance_to(caravan_ref.global_position)

	if dist <= detection_radius:
		trigger_attack()

func trigger_attack():
	# 🔴 IMPORTANT: store ONCE (no continuous tracking)
	target_position = caravan_ref.global_position
	has_target = true

	state = State.SWOOPING
	screech.play()
"

